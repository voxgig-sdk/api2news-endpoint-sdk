      }
    }
  },
  "components": {
    "schemas": {
      "Article": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the article"
          },
          "source": {
            "type": "string",
            "description": "News source (BBC, TechCrunch, CNN)",
            "example": "bbc"
          },
          "title": {
            "type": "string",
            "description": "Article headline",
            "example": "Breaking News: Major Technology Breakthrough"
          },
          "description": {
            "type": "string",
            "description": "Brief summary of the article"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "URL to the full article"
          },
          "imageUrl": {
            "type": "string",
            "format": "uri",
            "description": "URL to the article's featured image"
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Publication date and time"
          },
          "author": {
            "type": "string",
            "description": "Article author name"
          },
          "content": {
            "type": "string",
            "description": "Article content excerpt"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "message": {
            "type": "string",
            "description": "Error message describing what went wrong"
          },
          "code": {
            "type": "integer",
            "description": "Error code"
          }
        }
      }
    }
  }
}
