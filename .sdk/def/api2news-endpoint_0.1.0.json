              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of articles to return",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with TechCrunch news articles",
            "content": {
              "application/json": {
