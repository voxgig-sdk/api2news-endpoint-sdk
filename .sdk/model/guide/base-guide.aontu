# Generated from the API definition and overwritten on every build: do not
# edit this file. Put customizations in the guide entry file, which includes
# this one and overrides its defaults:
#   guide.aontu

guide: {
  metrics: count: entity: 4
  metrics: count: path: 4
  metrics: count: method: 4

  entity: bbc: {
    path: "/api/news/bbc": {
      op: list: method: *GET
      op: list: transform: res: *("`body.articles`")|top
    }
  }

  entity: cnn: {
    path: "/api/news/cnn": {
      op: list: method: *GET
      op: list: transform: res: *("`body.articles`")|top
    }
  }

  entity: new: {
    path: "/api/news": {
      op: list: method: *GET
      op: list: transform: res: *("`body.articles`")|top
    }
  }

  entity: techcrunch: {
    path: "/api/news/techcrunch": {
      op: list: method: *GET
      op: list: transform: res: *("`body.articles`")|top
    }
  }

}